{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/timer.html", "destination": "/timer", "permanent": false },
    { "source": "/todo.html", "destination": "/tasks", "permanent": false },
    { "source": "/notes.html", "destination": "/notes", "permanent": false }
  ],
  "rewrites": [
    { "source": "/timer", "destination": "/timer/index.html" },
    { "source": "/tasks", "destination": "/tasks/index.html" },
    { "source": "/notes", "destination": "/notes/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
